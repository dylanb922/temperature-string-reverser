				; ---------------------------------------------------------------------------------
				; Name: parseTempsFromString
				;
				; Parses through a string of ASCII-formatted values, converting them into signed
				; integers and storing the results in an SDWORD array.
				;
				; Preconditions: 
				;	[EBP+8] points to a buffer string with TEMPS_PER_DAY ASCII values
				;	[EBP+12] points to an SDWORD array with enough space to fit TEMPS_PER_DAY values
				;
				; Postconditions: The destination SDWORD array contains the converted values.
				;
				; Receives: 
				;	[EBP+8]		= address of the buffer of ASCII temps to read from
				;	[EBP+12]	= address of the SDWORD array to store the integer values in
				;
				; Returns: The array pointed to by [EBP+12] is filled with signed integer values
				; ---------------------------------------------------------------------------------
 000000DE			parseTempsFromString PROC
 000000DE  55				PUSH	EBP
 000000DF  8B EC			MOV		EBP, ESP
 000000E1  56				PUSH	ESI
 000000E2  57				PUSH	EDI
 000000E3  53				PUSH	EBX
 000000E4  51				PUSH	ECX
 000000E5  50				PUSH	EAX
 000000E6  52				PUSH	EDX

					; Point to both the source buffer and the destination array
 000000E7  8B 75 08			MOV		ESI, [EBP+8]
 000000EA  8B 7D 0C			MOV		EDI, [EBP+12]

 000000ED  B9 00000018			MOV		ECX, TEMPS_PER_DAY

 000000F2			_checkValueLoop:
 000000F2  51				PUSH	ECX			; Preserve loop counter to prevent overwrite from IMUL
 000000F3  BB 00000000			MOV		EBX, 0		; Clear EBX, so it can be used for negative flag
 000000F8  BA 00000000			MOV		EDX, 0		; Clear EDX, so it can store accumulated conversion value

					; Check first value in the byte to see if value is negative
 000000FD  8A 06			MOV		AL, [ESI]
 000000FF  3C 2D			CMP		AL, '-'
 00000101  75 06			JNE		_conversionLoop
 00000103  BB 00000001			MOV		EBX, 1		; Flag value as negative
 00000108  46				INC		ESI

 00000109			_conversionLoop:
 00000109  AC				LODSB				; Load current byte into AL, then increment forward in the string

					; Check for delimiter (signaling end of value)
 0000010A  3C 2C			CMP		AL, DELIMITER
 0000010C  74 0C			JE		_negativeCheck

					; Convert the ASCII value into an integer: 10 * numInt + (numChar - 48)
 0000010E  2C 30			SUB		AL, 48
 00000110  0F B6 C0			MOVZX	EAX, AL		; Must zero extend to match size
					
 00000113  6B D2 0A			IMUL	EDX, 10
 00000116  03 D0			ADD		EDX, EAX

					; Continue until a delimiter is reached
 00000118  EB EF			JMP		_conversionLoop	

 0000011A			_negativeCheck:
 0000011A  83 FB 01			CMP		EBX, 1
 0000011D  75 02			JNE		_storeValue
 0000011F  F7 DA			NEG		EDX

 00000121			_storeValue:
 00000121  89 17			MOV		[EDI], EDX
 00000123  83 C7 04			ADD		EDI, TYPE SDWORD

 00000126  59				POP		ECX
 00000127  E2 C9			LOOP	_checkValueLoop

 00000129  5A				POP		EDX
 0000012A  58				POP		EAX
 0000012B  59				POP		ECX
 0000012C  5B				POP		EBX
 0000012D  5F				POP		EDI
 0000012E  5E				POP		ESI
 0000012F  5D				POP		EBP
 00000130  C2 0008			RET		8
 00000133			parseTempsFromString ENDP

				; ---------------------------------------------------------------------------------
				; Name: writeTempsReverse
				;
				; Prints out the array in reverse order using string primitives, with values 
				; separated by delimiter characters.
				;
				; Preconditions: [EBP+8] is the address of an array of signed integers
				;
				; Receives: 
				;	[EBP+8]		= address of the array to print out in reverse
				; ---------------------------------------------------------------------------------
 00000133			writeTempsReverse PROC
 00000133  55				PUSH	EBP
 00000134  8B EC			MOV		EBP, ESP
 00000136  56				PUSH	ESI
 00000137  51				PUSH	ECX
 00000138  50				PUSH	EAX

 00000139  8B 75 08			MOV		ESI, [EBP+8]
 0000013C  83 C6 5C			ADD		ESI, (TEMPS_PER_DAY - 1) * TYPE SDWORD		; point to the end of array

					; Initialize loop counter
 0000013F  B9 00000018			MOV		ECX, TEMPS_PER_DAY

 00000144			_printLoop:
					; Set direction flag, then load the value then increment backwards
					; WriteInt possibly alters direction flag and causes it to print strangely if STD is set out of the loop
 00000144  FD				STD
 00000145  AD				LODSD

					; Print the value and a delimiter
 00000146  E8 00000000 E		CALL			WriteInt
					mDisplayChar	DELIMITER
 0000014B  50		     1		PUSH	EAX
 0000014C  B0 2C	     1		MOV		AL, DELIMITER
 0000014E  E8 00000000 E     1		CALL	WriteChar
 00000153  58		     1		POP		EAX

 00000154  E2 EE			LOOP	_printLoop

					; Clear direction flag
 00000156  FC				CLD

 00000157  58				POP		EAX
 00000158  59				POP		ECX
 00000159  5E				POP		ESI
 0000015A  5D				POP		EBP
 0000015B  C2 0004			RET		4
 0000015E			writeTempsReverse ENDP

				END main
